# Port server Express
PORT=4000

# Lingkungan: development | production
# Di produksi, beberapa pengaman berikut menjadi aktif secara otomatis.
NODE_ENV=development

# Origin frontend yang diizinkan CORS (tanpa trailing slash), pisahkan dengan koma.
# PENTING: hanya origin yang terdaftar di sini (atau di ALLOWED_EXTRA_ORIGINS)
# yang boleh memanggil API dengan kredensial. Pola wildcard *.vercel.app sudah
# DIHAPUS karena mengizinkan deployment milik siapa pun.
FRONTEND_ORIGIN=http://localhost:3000

# Origin tambahan yang diizinkan, mis. deployment preview/staging tertentu.
# Contoh: ALLOWED_EXTRA_ORIGINS=https://mbg-staging.vercel.app
ALLOWED_EXTRA_ORIGINS=

# Secret untuk menandatangani JWT (ganti dengan string acak yang panjang & rahasia)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# Supabase (project settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alamat layanan AI (endpoint /predict/waste dan /analyze/menu-correlation)
AI_SERVICE_URL=http://localhost:8000

# Kunci layanan internal untuk memanggil AI service.
# AI service kini menolak permintaan tanpa header X-Internal-Key bila
# AI_INTERNAL_KEY diatur di sana. Isi nilai ACAK yang sama di KEDUA layanan.
# Biarkan kosong hanya selama masa transisi (AI service akan memperingatkan).
AI_INTERNAL_KEY=

# Mode demo, jika true semua endpoint pakai data contoh
DEMO_MODE=true

# Kunci akses API untuk perangkat IoT (ESP32-CAM dan ESP8266)
# Dikirim lewat header "x-device-api-key".
# WAJIB diisi di produksi: bila kosong, endpoint IoT akan MENOLAK akses (fail-closed).
DEVICE_API_KEY=ganti-dengan-kunci-perangkat-acak-yang-kuat

# Izinkan endpoint IoT tanpa autentikasi. Default false.
# Jangan aktifkan di produksi kecuali benar-benar disengaja.
ALLOW_UNAUTHENTICATED_IOT=false

# Roboflow untuk deteksi sisa makanan pada smart container
# Pakai salah satu: isi ROBOFLOW_WORKFLOW_ID (Workflows API) ATAU
# ROBOFLOW_MODEL + ROBOFLOW_VERSION (Inference API klasik).
# Prioritas: WORKFLOW_ID > MODEL.
# Bila API key kosong ATAU panggilan API gagal, backend mengembalikan mode 'mock'
# dan (secara default) TIDAK menyimpan hasilnya ke database produksi.
ROBOFLOW_API_KEY=your_key_here
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_MODEL=your_model_id
ROBOFLOW_VERSION=1

# --- Perilaku penyimpanan hasil simulasi ---
# true  = hasil mode 'mock' DIIZINKAN tersimpan ke tabel produksi (JANGAN di produksi:
#         menyebabkan data simulasi tercampur tanpa bisa dibedakan).
# false = hasil mock tidak disimpan; hanya dikembalikan sebagai respons.
MOCK_ALLOW_PERSIST=false

# --- Estimasi berat berbasis citra ---
# luas_bbox_v1 = perilaku lama: bagi berat proporsional luas bounding box,
#                confidence diabaikan. (default, belum berubah)
# densitas_v2  = memperhitungkan densitas jenis makanan dan confidence.
#                WAJIB dikalibrasi sebelum diaktifkan di produksi.
SKEMA_BERAT=luas_bbox_v1

# Parameter skema densitas_v2:
# Ambang confidence minimum agar deteksi ikut menentukan distribusi.
CONFIDENCE_THRESHOLD=0.4
# Eksponen ukuran->volume (1.0 = asumsi luas=massa; 1.5 = asumsi 3D isotropik).
SIZE_EXPONENT=1.0
# Eksponen pembobotan confidence (0 = tidak dibobot; 1 = proporsional linear).
CONFIDENCE_EXPONENT=0.0

# Paksa backend berhenti bila migrasi provenance belum dijalankan.
# Di produksi sudah otomatis aktif lewat NODE_ENV=production.
SKEMA_ENFORCE=false

# Broker MQTT untuk transport perangkat IoT (ESP32-CAM & ESP8266)
# Gunakan broker terkelola (EMQX Cloud, HiveMQ) atau self-hosted Mosquitto untuk production
# Kosongkan untuk menonaktifkan MQTT (perangkat memakai fallback REST)
MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mbg

# ============================================================================
# PARAMETER OPERASIONAL (opsional — semua punya nilai default yang aman)
# Semua di bawah ini boleh TIDAK diisi. Hanya ubah bila perlu disetel.
# ============================================================================

# Nama service pada log terstruktur (memudahkan pencarian di agregator log).
SERVICE_NAME=mbg-backend

# Tingkat log: debug | info | warn | error
LOG_LEVEL=info

# --- Performa ---
# Cache pencarian batch maggot aktif (ms). Pengukuran menunjukkan query ini
# memakan 411-890 ms setiap siklus telemetri 30 detik. Cache 60000 ms
# menurunkan rantai telemetri dari ~924 ms menjadi ~298 ms.
BATCH_CACHE_MS=60000

# Jeda penyegaran state (mode pemeliharaan & demo) dari database (ms).
# Relevan bila backend berjalan lebih dari satu replika.
STATE_REFRESH_MS=30000

# Jumlah trace latency yang disimpan di memori untuk GET /api/kinerja.
LATENCY_BUFFER=200

# --- Batas laju per menit (per alamat IP) ---
RATE_LIMIT_BERAT=20
# Endpoint yang memanggil AI service atau mengekspor data
RATE_LIMIT_PERANGKAT=30
# Perintah ke perangkat fisik (reboot, kalibrasi) - dibatasi ketat
RATE_LIMIT_BACA=120
# Endpoint baca dashboard

# --- Ekspor data ---
# Batas baris per unduhan CSV. Bila terlampaui, respons memuat header
# X-Data-Terpotong. Naikkan hanya bila memori server mencukupi.
CSV_MAKS_BARIS=50000

# --- Roboflow (lanjutan, biasanya tidak perlu diubah) ---
# Alamat server Workflows API Roboflow.
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com
# Nama field input citra pada payload workflow.
ROBOFLOW_WORKFLOW_INPUT=image
