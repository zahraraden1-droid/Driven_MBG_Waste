# Port server Express
PORT=4000

# Origin frontend yang diizinkan CORS (tanpa trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Secret untuk menandatangani JWT (ganti dengan string acak yang panjang & rahasia)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# Supabase (project settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alamat layanan AI lokal (endpoint /predict/waste dan /analyze/menu-correlation)
AI_SERVICE_URL=http://localhost:8000

# Mode demo, jika true semua endpoint pakai data contoh
DEMO_MODE=true
