# Port server Express
PORT=4000

# Origin frontend yang diizinkan CORS (tanpa trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Secret untuk menandatangani JWT (ganti dengan string acak yang panjang & rahasia)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# Supabase (project settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alamat layanan AI lokal (endpoint /predict/waste dan /analyze/menu-correlation)
AI_SERVICE_URL=http://localhost:8000

# Mode demo, jika true semua endpoint pakai data contoh
DEMO_MODE=true

# Kunci akses API untuk perangkat IoT (ESP32-CAM dan ESP8266)
# Dikirim lewat header "x-device-api-key". Kosongkan jika ingin uji coba tanpa proteksi.
DEVICE_API_KEY=sppg-mbg-iot-secure-key-2026

# Roboflow untuk deteksi sisa makanan pada smart container
# Kosongkan untuk memakai mode simulasi cerdas bawaan backend
# Pakai salah satu: isi ROBOFLOW_WORKFLOW_ID (Workflows API) ATAU
# ROBOFLOW_MODEL + ROBOFLOW_VERSION (Inference API klasik).
# Prioritas: WORKFLOW_ID > MODEL.
ROBOFLOW_API_KEY=your_key_here
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_MODEL=your_model_id
ROBOFLOW_VERSION=1

# Broker MQTT untuk transport perangkat IoT (ESP32-CAM & ESP8266)
# Gunakan broker terkelola (EMQX Cloud, HiveMQ) atau self-hosted Mosquitto untuk production
# Kosongkan untuk menonaktifkan MQTT (perangkat memakai fallback REST)
MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mbg
