#ifndef SECRETS_H
#define SECRETS_H

// --- WiFi lokasi ---
#define SECRET_WIFI_SSID "GANTI_SSID_WIFI"
#define SECRET_WIFI_PASS "GANTI_PASSWORD_WIFI"

// --- Broker MQTT ---
#define SECRET_MQTT_SERVER "GANTI_HOST_BROKER"
#define SECRET_MQTT_PORT 1883
#define SECRET_MQTT_USER "GANTI_USER_MQTT"
#define SECRET_MQTT_PASS "GANTI_PASSWORD_MQTT"

// --- Prefix topik (harus sama dengan MQTT_TOPIC_PREFIX di backend) ---
#define SECRET_MQTT_PREFIX "mbg"

// --- ID batch untuk telemetri chamber (boleh kosong) ---
#define SECRET_BATCH_ID ""

#endif // SECRETS_H
