# ============================================================
# SPPG MBG — Environment PRODUCTION (isi lalu rename jadi .env)
# Letakkan di folder deploy/ (ini tidak di-commit, aman)
# ============================================================

# --- Backend Express ---
PORT=4000
NODE_ENV=production

# Origin frontend yang diizinkan CORS. Pisahkan dengan koma jika lebih dari satu.
FRONTEND_ORIGIN=https://driven-mbg-waste.vercel.app,http://localhost:3000

# Ganti dengan string acak yang panjang (min 32 karakter).
JWT_SECRET=ubah-saya-ke-string-acak-panjang-sekali-jangan-samakan-dengan-dev

# --- Supabase (project settings > API) ---
SUPABASE_URL=https://rwnabetybudpyxpnydid.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-dari-supabase

# --- Layanan AI lokal (di-set otomatis oleh compose menjadi http://ai-service:8000) ---
AI_SERVICE_URL=http://ai-service:8000

# Mode demo: false = produksi (baca data asli Supabase + panggil AI)
DEMO_MODE=false

# Kunci perangkat IoT (ESP32-CAM & ESP8266) — kirim lewat header "x-device-api-key"
DEVICE_API_KEY=ubah-saya-ke-kunci-perangkat-acak

# --- Roboflow (sisa pangan) ---
ROBOFLOW_API_KEY=isi-key-roboflow-disini
ROBOFLOW_MODEL=isi-model-id
ROBOFLOW_VERSION=1

# --- MQTT broker (di-set otomatis oleh compose menjadi mqtt://mosquitto:1883) ---
# Untuk ESP di lapangan, pakai alamat publik VPS kamu (port 1883).
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=mbg_device
MQTT_PASSWORD=ubah-saya-ke-password-mqtt
MQTT_TOPIC_PREFIX=mbg